# ------------------------------------------------------------------------------
# BACKEND PRODUCTION ENVIRONMENT VARIABLES (Railway)
# ------------------------------------------------------------------------------

# General Application Settings
PROJECT_NAME="Bike ModAI V5"
VERSION="5.1"

# Automatically injected by Railway, but can be set manually for local testing
PORT=8000

# Security & CORS (comma separated list of allowed origins)
ALLOWED_ORIGINS="https://your-frontend-app.vercel.app,http://localhost:3000"

# Database Configuration (PostgreSQL/MongoDB provided by Railway)
DATABASE_URL=postgresql://user:password@containers-us-west.railway.app:5432/railway
REDIS_URL=redis://default:password@containers-us-west.railway.app:6379

# AI Model Paths
YOLO_MODEL_PATH="models/yolov8n-seg.onnx"
OCR_MODEL_PATH="models/ocr"

# Secret Keys
JWT_SECRET="generate-a-secure-random-string-here"
