# AXION Enterprise Production Configuration
# Copy this file to .env or .env.local and populate actual values for production deployment

# Application Settings
PROJECT_NAME="AXION - AI Motorcycle Modification Detector"
VERSION="5.2.0"
ENVIRONMENT="production"

# Database Configuration (SQLite default)
DATABASE_URL="sqlite:///./modai.db"

# JWT Authentication Security (Generate a secure random secret in production)
JWT_SECRET_KEY="replace_with_a_secure_random_256_bit_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Next.js Public API Base URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# CORS Allowed Origins (Comma-separated list)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
