# ============================================================
# Vehicle ModAI — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# FastAPI
PROJECT_NAME=Vehicle ModAI
VERSION=5.0

# ── Database ─────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_NAME=vehicle_mod_ai

# ── Security ─────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_to_a_long_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Telegram Alerts (optional) ───────────────────────────────
# Create a bot via @BotFather and get your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email Alerts via SMTP (optional) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL=enforcement@yourdomain.com

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
